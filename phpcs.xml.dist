<?xml version="1.0"?>
<ruleset name="x-scroll-to-top-responsive">
    <description>WordPress standards; existing findings are tracked in phpcs-baseline.json.</description>
    <file>plugin-hook.php</file>
    <file>Class/</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <config name="testVersion" value="5.4-"/>
    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
